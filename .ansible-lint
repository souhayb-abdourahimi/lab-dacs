---
# Configuration ansible-lint (lancé depuis la racine du dépôt : make lint, CI)
profile: production
exclude_paths:
  - .cache/
  - .github/
  - docker/
  - supervision/
  - adguard/
  - configs/
  # Fichiers propres à chaque utilisateur, générés par install.sh (non versionnés)
  - ansible/group_vars/all.yml
  - ansible/inventory/hosts.yml
